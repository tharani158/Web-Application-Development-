NODE_ENV=development
PORT=5000
# Leave MONGO_URI empty to use the in-memory development database.
MONGO_URI=
# Replace with a unique random secret of at least 32 characters before starting.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Optional: configure an initial administrator account. No shared default account is created.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
